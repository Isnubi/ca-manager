# ==========================================
# CA Manager — Environment Configuration
# ==========================================

# REQUIRED: Set a long random string. Changing this will invalidate all sessions.
SECRET_KEY=change-this-to-a-long-random-secret

# Data directories (Docker volume paths — do not change unless you update compose.yml)
DATA_DIR=/app/data
CA_DIR=/opt/private-ca

# --- CA Subject Fields ---
# These are the defaults used when initializing the CA and issuing certificates.
# They can also be changed at runtime via the web UI Settings page.
CA_COUNTRY=FR
CA_STATE=Country
CA_LOCALITY=City
CA_ORG=Homelab
CA_OU=Services

# --- Certificate Validity ---
DAYS_VALID_CERT=375
DAYS_VALID_ROOT=3650

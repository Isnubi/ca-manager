# ==========================================
# CA Manager — Environment Configuration
# ==========================================

# Session signing secret (at least 32 characters). Changing it invalidates all sessions.
# Leave empty to let the app generate a random key, stored in DATA_DIR/secret_key.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to true when CA Manager is served over HTTPS (e.g. behind a reverse proxy).
SESSION_COOKIE_SECURE=false

# Data directories (Docker volume paths — do not change unless you update compose.yml)
DATA_DIR=/app/data
CA_DIR=/opt/private-ca

# --- CA Subject Fields ---
# These are the defaults used when initializing the CA and issuing certificates.
# They can also be changed at runtime via the web UI Settings page.
CA_COUNTRY=FR
CA_STATE=Country
CA_LOCALITY=City
CA_ORG=Homelab
CA_OU=Services

# --- Certificate Validity ---
DAYS_VALID_CERT=375
DAYS_VALID_ROOT=3650
